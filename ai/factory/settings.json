{
  "model": "custom:gpt-5-medium",
  "reasoningEffort": "none",
  "cloudSessionSync": false,
  "diffMode": "github",
  "ideExtensionPromptedAt": {},
  "autonomyLevel": "auto-low",
  "ideActivationNudgedForVersion": {},
  "enableCompletionBell": false,
  "commandAllowlist": [
    "ls",
    "pwd",
    "dir",
    "just fmt",
    "just format",
    "just test",
    "mise fmt",
    "mise format",
    "mise test",
    "mix test",
    "go test",
    "bun test",
    "npm test"
  ],
  "commandDenylist": [
    "rm -rf /",
    "rm -rf /*",
    "rm -rf .",
    "rm -rf ~",
    "rm -rf ~/*",
    "rm -rf $HOME",
    "rm -r /",
    "rm -r /*",
    "rm -r ~",
    "rm -r ~/*",
    "mkfs",
    "mkfs.ext4",
    "mkfs.ext3",
    "mkfs.vfat",
    "mkfs.ntfs",
    "dd if=/dev/zero of=/dev",
    "dd of=/dev",
    "shutdown",
    "reboot",
    "halt",
    "poweroff",
    "init 0",
    "init 6",
    ":(){ :|: & };:",
    ":() { :|:& };:",
    "chmod -R 777 /",
    "chmod -R 000 /",
    "chown -R",
    "format",
    "powershell Remove-Item -Recurse -Force"
  ],
  "enableCustomDroids": true,
  "includeCoAuthoredByDroid": false,
  "enableDroidShield": true,
  "specSaveEnabled": true
}
