        "!elixir-ls",
        "!dexter",
        "!next-ls",
        "!lexical",
      ],
    },
    "HEEx": {
      "language_servers": [
        "expert",
        "!elixir-ls",
        "!dexter",
        "!next-ls",
        "!lexical",
      ],
    },
    "Swift": {
      "enable_language_server": true,
      "language_servers": ["sourcekit-lsp"],
      "formatter": "language_server",
      "format_on_save": "on",
    },
  },
