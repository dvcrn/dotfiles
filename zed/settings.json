{
  "context_server_timeout": 120,
  "diff_view_style": "unified",
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "status_bar": {
    "show_active_file": true,
  },
  "proxy": "",
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "ui_font_weight": 450.0,
