  "icon_theme": "Catppuccin Frappé",
  "edit_predictions": {
    "provider": "zed",
    "allow_data_collection": "no",
    "disabled_globs": [],
    "mode": "subtle",
    "codestral": {
      "model": "codestral-latest",
      "max_tokens": 500,
    },
  },
  "show_edit_predictions": true,
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "errors",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
    "enable_keep_preview_on_code_navigation": true,
  },
  "auto_signature_help": true,
  "show_signature_help_after_edits": true,
  "cursor_shape": "bar",
  "outline_panel": {
    "dock": "right",
  },
  "inlay_hints": {
    "enabled": false,
  },
  "agent": {
    "sandbox_permissions": {
      "allow_fs_write_all": true,
      "allow_unsandboxed": true,
      "allow_all_hosts": true,
      "network_hosts": [
        "artist-lineup-cdn.tomorrowland.com",
        "amicorum.app",
        "dev.amicorum.app",
        "developers.cloudflare.com",
        "raw.githubusercontent.com",
        "api.github.com",
        "www.rfc-editor.org",
        "developer.apple.com",
        "github.com",
        "pkg.go.dev",
        "go.dev",
        "developer.android.com",
        "dl.google.com"
      ]
    },
    "thinking_display": "always_collapsed",
    "show_turn_stats": true,
    "enable_feedback": false,
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "agy .*"
            },
            {
              "pattern": "codex .*"
            }
          ],
          "always_confirm": [],
          "always_deny": [
            {
              "pattern": "git stash .*"
            },
            {
              "pattern": "git checkout .*"
            },
            {
              "pattern": "git restore .*"
            },
            {
              "pattern": "rm -rf .*"
            }
          ],
        },
      },
      "default": "allow",
    },
    "dock": "left",
